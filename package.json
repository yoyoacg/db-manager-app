{
  "name": "db-service-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 多数据库服务一键管理器（描述符驱动）",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.21.5",
    "@rollup/rollup-win32-x64-msvc": "^4.62.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^30.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vue": "^3.5.13"
  },
  "build": {
    "appId": "com.yoyo.db-service-manager",
    "productName": "DB 服务管理器",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DB 服务管理器"
    }
  }
}
