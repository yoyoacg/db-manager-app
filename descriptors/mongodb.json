{
  "id": "mongodb",
  "displayName": "MongoDB",
  "description": "文档型数据库。解压即用，首次启动自动创建数据目录。配置文件 mongod.cfg 可在「配置」中编辑。",
  "source": {
    "type": "http",
    "versions": {
      "7.0.14": "https://fastdl.mongodb.org/windows/mongodb-windows-x86_64-7.0.14.zip",
      "6.0.16": "https://fastdl.mongodb.org/windows/mongodb-windows-x86_64-6.0.16.zip"
    }
  },
  "install": { "binPath": "bin/mongod.exe" },
  "config": {
    "file": "mongod.cfg",
    "template": [
      "storage:",
      "  dbPath: {dataDir}",
      "net:",
      "  port: {port}",
      "  bindIp: 127.0.0.1",
      "systemLog:",
      "  destination: file",
      "  path: {dataDir}/mongod.log",
      "  logAppend: true"
    ]
  },
  "runtime": {
    "startArgs": ["--config", "{configFile}"],
    "port": 27017,
    "startTimeoutMs": 30000,
    "windowsServiceName": "MongoDB"
  }
}
